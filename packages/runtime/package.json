    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "dist:smoke": "node scripts/dist-smoke.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
